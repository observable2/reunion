<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="./data/favicon.ico">
    <style type="text/css">
      /* Colours come from the kit's theme variables, set once on body below.
         The notebook theme is "midnight" (dark) in index.html so the kit's
         colour-scheme matches the page. The serif is the kit's --serif
         variable, which names the web font "Source Serif 4 Variable". */
      @import url("observable:styles/index.css");
      @import url("@fontsource-variable/source-serif-4/opsz.css");
      @import url("@fontsource-variable/source-serif-4/opsz-italic.css");

      /* neutralise the kit's page chrome (body margin/padding, <main> max-width) */
      html, body {
        margin: 0;
        padding: 0;
      }
      body {
        /* Set on body, not :root: the theme stylesheet is injected after this
           one and would win a same-specificity :root override. */
        --theme-background: #00182f;
        --theme-foreground: floralwhite;
        cursor: none;
      }
      main {
        margin: 0;
        max-width: none;
      }

      #field {
        position: absolute;
        top: 7vw;
        /* centred on the extent of its spels; see centerField in scoringthespeltair */
        left: calc((100% - var(--extent-w, 0vw)) / 2 - var(--extent-x, 0vw));
        font-family: var(--serif);
        font-size: 2.5vw;
        font-variant-ligatures: no-common-ligatures;
        line-height: 1.8;
        user-select: none;
        -webkit-user-select: none; /* Safari */
        transition: opacity 2.5s ease-in-out;
      }

      #byline {
        color: var(--theme-foreground);
        font-size: 1.6vw;
        line-height: 1.1;
        padding: 2vw 10vw .5vw;
        text-align: center;
        z-index: 10;
        cursor: pointer;
        opacity: 0;
        transition: opacity .7s ease-in-out;
      }

      #byline:hover {
        opacity: 1;
      }

      #byline a {
        color: var(--theme-foreground);
        text-decoration: none;
      }

      #byline a:hover {
        color: lightgray;
      }

      .spel {
        position: absolute;
        opacity: 0;
        transition: all 1.5s ease-in-out;
      }

      .spel.visible {
        opacity: 1;
      }
    </style>
  </head>
  <body>
    <main></main>
  </body>
</html>
